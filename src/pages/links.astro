---
// Página de enlaces para la bio de Instagram: una sola columna pensada para el móvil,
// con el acceso al portfolio y a las redes.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import '../styles/editorial-home.css';
import logo from '../assets/brand/logo.png';
import { contactSection, heroContent } from '../data/site';
import ArrowIcon from '../components/icons/ArrowIcon.astro';
import BrandIcon from '../components/icons/BrandIcon.astro';
import NeuralBackground from '../components/NeuralBackground.astro';
---

<Layout
	title={`Links | ${heroContent.name}`}
	description={`${heroContent.name}, ${heroContent.role}. Portfolio y redes en un solo lugar.`}
>
	<main class="ed-home links-page" id="top">
		<NeuralBackground />
		<div class="links-inner">
			<header class="links-head">
				<span class="links-avatar">
					<Image src={logo} alt="" width={88} height={88} loading="eager" />
				</span>
				<h1 class="links-name">{heroContent.name}</h1>
				<p class="links-role">{heroContent.role}</p>
			</header>

			<nav class="links-group" aria-label="Enlaces">
				<a class="link-card" href="/">
					<span class="link-text">
						<span class="link-label">Portfolio</span>
						<span class="link-detail">Experiencia, proyectos y contacto</span>
					</span>
					<span class="arrow">
						<ArrowIcon direction="right" />
					</span>
				</a>
				{
					contactSection.items.map((item) => (
						<a class="link-card" href={item.href} target="_blank" rel="noopener noreferrer">
							<span class="link-icon">
								<BrandIcon name={item.icon} />
							</span>
							<span class="link-text">
								<span class="link-label">{item.label}</span>
								<span class="link-detail">{item.value}</span>
							</span>
							<span class="arrow">
								<ArrowIcon direction="ne" />
							</span>
						</a>
					))
				}
			</nav>

			<p class="links-foot">© {new Date().getFullYear()} · {heroContent.name}</p>
		</div>
	</main>
</Layout>

<style>
	.links-page {
		min-height: 100dvh;
		background: var(--bg);
	}
	.links-inner {
		position: relative;
		z-index: 1;
		max-width: 480px;
		margin-inline: auto;
		padding: clamp(2.5rem, 8vw, 4.5rem) 1.25rem 3rem;
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
	}

	.links-head {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.links-avatar {
		width: 88px;
		height: 88px;
		border-radius: 50%;
		overflow: hidden;
		border: 1px solid var(--line-strong);
		margin-bottom: 1.1rem;
	}
	.links-avatar :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.links-name {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: var(--heading-weight);
		font-size: 1.6rem;
		letter-spacing: -0.01em;
		color: var(--text);
	}
	.links-role {
		margin: 0.35rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.links-group {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.link-card {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		min-height: 3.5rem;
		padding: 0.85rem 1.1rem;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--surface);
		color: var(--text);
		transition:
			border-color 0.3s var(--ease),
			transform 0.3s var(--ease),
			background 0.3s var(--ease);
	}
	.link-card:hover {
		border-color: var(--line-strong);
		background: var(--bg-2);
		transform: translateY(-1px);
	}
	.link-card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.link-icon {
		display: inline-flex;
		color: var(--text-2);
	}
	.link-icon :global(.brand-icon) {
		width: 20px;
		height: 20px;
	}
	.link-text {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}
	.link-label {
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 1rem;
	}
	.link-detail {
		font-size: 0.82rem;
		color: var(--muted);
	}
	.link-card .arrow {
		color: var(--muted);
		transition:
			transform 0.35s var(--ease),
			color 0.3s var(--ease);
	}
	.link-card:hover .arrow {
		color: var(--accent);
		transform: translateX(3px);
	}

	.links-foot {
		margin: 0.5rem 0 0;
		text-align: center;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--faint);
	}

	@media (prefers-reduced-motion: reduce) {
		.link-card,
		.link-card .arrow {
			transition: none;
		}
		.link-card:hover,
		.link-card:hover .arrow {
			transform: none;
		}
	}
</style>
