---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getLocalImage } from '../lib/images';
import ArrowIcon from './icons/ArrowIcon.astro';
import ProjectPreview from './ProjectPreview.astro';

interface Props {
	featured: CollectionEntry<'projects'> | undefined;
	rest: CollectionEntry<'projects'>[];
}

const { featured, rest } = Astro.props;

const allProjects = [...(featured ? [featured] : []), ...rest];

function projectImages(entry: CollectionEntry<'projects'>): string[] {
	return entry.data.images
		.filter((img): img is typeof img & { src: string } => img.status === 'ready' && !!img.src)
		.map((img) => getLocalImage(img.src)?.src ?? img.src);
}

// Captura fija para pantallas táctiles: prioriza el dashboard, si no la primera lista.
function projectThumb(entry: CollectionEntry<'projects'>) {
	const ready = entry.data.images.filter((img) => img.status === 'ready' && !!img.src);
	const pick = ready.find((img) => img.role === 'dashboard') ?? ready[0];
	if (!pick?.src) return undefined;
	const local = getLocalImage(pick.src);
	return local ? { image: local, alt: pick.alt } : undefined;
}
---

<section class="ed-section" id="projects">
	<div class="wrap">
		<div class="sec-head reveal">
			<span class="sec-num">(02)</span>
			<h2 class="sec-label">Proyectos seleccionados</h2>
			<span class="rule-flex"></span>
		</div>

		<div class="projects-list">
			{
				allProjects.map((p, i) => {
					const images = projectImages(p);
					const availableLinks = p.data.links.filter((l) => l.available);
					const thumb = projectThumb(p);
					return (
						<article
							class="proj-row reveal"
							data-preview-images={images.length ? JSON.stringify(images) : undefined}
						>
							<span class="r-index">{String(i + 1).padStart(2, '0')}</span>
							<span class="r-name">
								<span transition:name={`proj-name-${p.id}`}>{p.data.name}</span>
								<span class="r-eyebrow">{p.data.eyebrow}</span>
							</span>
							<div class="r-desc">
								{p.data.tagline}
								<div class="r-tags">
									{p.data.tech.slice(0, 4).map((t) => (
										<span class="tag">{t}</span>
									))}
								</div>
							</div>
							{thumb && (
								<figure class="r-thumb">
									<Image
										src={thumb.image}
										alt={thumb.alt}
										widths={[400, 720]}
										sizes="(max-width: 600px) calc(100vw - 4rem), 560px"
										loading="lazy"
									/>
									<figcaption>{p.data.name}</figcaption>
								</figure>
							)}
							<div class="r-action">
								{availableLinks.length > 0 ? (
									availableLinks.map((l) => {
										const ext = l.href.startsWith('http');
										return (
											<a
												class={`tlink${l.kind === 'github-private' ? ' tlink-private' : ''}`}
												href={l.href}
												target={ext ? '_blank' : undefined}
												rel={ext ? 'noopener noreferrer' : undefined}
											>
												{l.label}{' '}
												<span class="arrow">
													<ArrowIcon direction="ne" />
												</span>
											</a>
										);
									})
								) : (
									<span class="tlink disabled">Detalles pronto</span>
								)}
							</div>
						</article>
					);
				})
			}
		</div>
	</div>
</section>

<ProjectPreview />

<style>
	.tlink-private {
		opacity: 0.65;
		font-style: italic;
	}
</style>
