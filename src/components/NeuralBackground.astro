---
// Fondo animado en el lenguaje del logo: nodos grises de distintos tamaños que se
// desplazan despacio y se unen con trazos curvos cuando están cerca. Canvas fijo
// detrás del contenido; con prefers-reduced-motion se dibuja un solo cuadro quieto.
---

<canvas class="neural-bg" id="neuralBg" aria-hidden="true"></canvas>

<style>
	.neural-bg {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
		/* Se desvanece hacia el centro para que el texto siga leyéndose limpio */
		mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, rgba(0, 0, 0, 0.35), #000 85%);
	}
</style>

<script>
	interface Node {
		x: number;
		y: number;
		vx: number;
		vy: number;
		r: number;
		shade: number;
	}

	const LINK_DIST = 130;
	const SPEED = 0.18;
	// Tonos del logo: del gris oscuro al blanco hueso
	const SHADES = ['74, 72, 68', '110, 107, 101', '150, 146, 139', '200, 196, 188', '244, 242, 238'];

	let frame = 0;
	let cleanup: (() => void) | null = null;

	function init() {
		const canvas = document.getElementById('neuralBg') as HTMLCanvasElement | null;
		const ctx = canvas?.getContext('2d');
		if (!canvas || !ctx) return;

		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let w = 0;
		let h = 0;
		let nodes: Node[] = [];

		function resize() {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			w = window.innerWidth;
			h = window.innerHeight;
			canvas!.width = w * dpr;
			canvas!.height = h * dpr;
			ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

			const count = Math.round(Math.min(90, Math.max(28, (w * h) / 11000)));
			nodes = Array.from({ length: count }, () => {
				const angle = Math.random() * Math.PI * 2;
				const speed = SPEED * (0.4 + Math.random() * 0.6);
				return {
					x: Math.random() * w,
					y: Math.random() * h,
					vx: Math.cos(angle) * speed,
					vy: Math.sin(angle) * speed,
					r: 1.5 + Math.random() * Math.random() * 4.5,
					shade: Math.floor(Math.random() * SHADES.length)
				};
			});
			if (reduce) draw();
		}

		function draw() {
			ctx!.clearRect(0, 0, w, h);

			// Conexiones: curva suave cuyo arco depende del par, como los trazos del logo
			ctx!.lineWidth = 1;
			for (let i = 0; i < nodes.length; i++) {
				const a = nodes[i];
				for (let j = i + 1; j < nodes.length; j++) {
					const b = nodes[j];
					const dx = b.x - a.x;
					const dy = b.y - a.y;
					const d = Math.hypot(dx, dy);
					if (d > LINK_DIST) continue;
					const alpha = (1 - d / LINK_DIST) * 0.35;
					const bend = ((i + j) % 2 ? 0.18 : -0.18) * d;
					const mx = (a.x + b.x) / 2 - (dy / d) * bend;
					const my = (a.y + b.y) / 2 + (dx / d) * bend;
					ctx!.strokeStyle = `rgba(${SHADES[Math.max(a.shade, b.shade)]}, ${alpha})`;
					ctx!.beginPath();
					ctx!.moveTo(a.x, a.y);
					ctx!.quadraticCurveTo(mx, my, b.x, b.y);
					ctx!.stroke();
				}
			}

			for (const n of nodes) {
				ctx!.fillStyle = `rgba(${SHADES[n.shade]}, 0.55)`;
				ctx!.beginPath();
				ctx!.arc(n.x, n.y, n.r, 0, Math.PI * 2);
				ctx!.fill();
			}
		}

		function step() {
			for (const n of nodes) {
				n.x += n.vx;
				n.y += n.vy;
				// Al salir por un borde reaparece por el opuesto
				if (n.x < -20) n.x = w + 20;
				else if (n.x > w + 20) n.x = -20;
				if (n.y < -20) n.y = h + 20;
				else if (n.y > h + 20) n.y = -20;
			}
			draw();
			frame = requestAnimationFrame(step);
		}

		function onVisibility() {
			cancelAnimationFrame(frame);
			if (!document.hidden && !reduce) frame = requestAnimationFrame(step);
		}

		let resizeTimer = 0;
		function onResize() {
			clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(resize, 150);
		}

		resize();
		if (!reduce) frame = requestAnimationFrame(step);
		window.addEventListener('resize', onResize);
		document.addEventListener('visibilitychange', onVisibility);

		cleanup = () => {
			cancelAnimationFrame(frame);
			clearTimeout(resizeTimer);
			window.removeEventListener('resize', onResize);
			document.removeEventListener('visibilitychange', onVisibility);
		};
	}

	document.addEventListener('astro:before-swap', () => {
		cleanup?.();
		cleanup = null;
	});
	document.addEventListener('astro:page-load', init);
</script>
