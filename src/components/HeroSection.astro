---
import type { HeroContent } from '../data/site';
import ArrowIcon from './icons/ArrowIcon.astro';
import HeroExploded from './HeroExploded.astro';

interface Props {
	hero: HeroContent;
	heroStack: string[];
}

const { hero, heroStack } = Astro.props;
---

<section class="ed-hero" id="sobre-mi">
	<div class="wrap">
		<div class="hero-top">
			<span class="ed-eyebrow"><span class="dot"></span>{hero.role}</span>
			<span class="hero-availability">Disponible para oportunidades</span>
		</div>

		<div class="ed-hero-grid ed-hero-grid--home">
			<div class="ed-hero-copy">
				<div class="hero-frame">
					<span class="reg reg-tl" aria-hidden="true"></span>
					<span class="reg reg-tr" aria-hidden="true"></span>
					<span class="reg reg-bl" aria-hidden="true"></span>
					<span class="reg reg-br" aria-hidden="true"></span>
					<h1 class="hero-title hero-name">{hero.name}</h1>
				</div>
				<p class="hero-intro">{hero.subtitle}</p>
				<div class="hero-narr-wrap">
					<p class="hero-narrative">{hero.narrative}</p>
					<p class="hero-narrative">{hero.panelSummary}</p>
				</div>
				<div class="cta-row">
					<a class="btn" href={hero.primaryCta.href}>
						{hero.primaryCta.label}
						<span class="arrow"><ArrowIcon direction="ne" /></span>
					</a>
					<a
						class="btn btn-ghost"
						href={hero.secondaryCta.href}
						download={hero.secondaryCta.download}
					>
						{hero.secondaryCta.label}
						<span class="arrow"><ArrowIcon direction="down" /></span>
					</a>
				</div>
			</div>

			<aside class="hero-meta">
				<HeroExploded />
				<div class="meta-row meta-row--focus">
					<span class="meta-k">Enfoque</span>
					<span class="meta-v"
						>Entender la operación antes que el sistema. Decisiones técnicas sostenibles.</span
					>
				</div>
				<div class="meta-row">
					<span class="meta-k">Stack principal</span>
					<div class="tag-row">
						{heroStack.map((t) => <span class="tag">{t}</span>)}
					</div>
				</div>
			</aside>
		</div>
	</div>
</section>
